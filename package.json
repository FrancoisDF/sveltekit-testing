{
	"private": true,
	"name": "root",
	"scripts": {
		"dev": "pnpm build_deps && pnpm --filter \"./apps/web/**\" dev",
		"build": "pnpm build_deps && pnpm build_web",
		"build_deps": "pnpm --filter \"./packages/**\" build",
		"build_web": "pnpm --filter \"./apps/web/**\" build"
	},
	"packageManager": "pnpm@9.15.2",
	"engines": {
		"pnpm": ">= 9.15.0",
		"yarn": "Please use pnpm instead of yarn.",
		"npm": "Please use pnpm instead of npm."
	}
}